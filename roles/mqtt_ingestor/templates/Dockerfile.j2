# =============================================================================
# Multi-stage Dockerfile for mqtt-ingestor
#
# Stage 1 (base):   python:3.12-slim + Microsoft ODBC Driver 18 + unixodbc
# Stage 2 (builder): base + build tools; pip installs to /install prefix
# Stage 3 (runtime): base + copied /install; non-root user; EXPOSE 8080 9108
# =============================================================================

# ── Stage 1: base image with ODBC runtime ────────────────────────────────────
FROM python:3.12-slim AS base

ARG DEBIAN_FRONTEND=noninteractive

# Microsoft ODBC Driver 18 for SQL Server
# Ref: https://learn.microsoft.com/sql/connect/odbc/linux-mac/installing-the-microsoft-odbc-driver-for-sql-server
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        gnupg \
        ca-certificates \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
       | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list \
       > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends \
        msodbcsql18 \
        unixodbc \
        libgssapi-krb5-2 \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=UTC


# ── Stage 2: builder (compile pyodbc wheel) ───────────────────────────────────
FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        unixodbc-dev \
        gcc \
    && rm -rf /var/lib/apt/lists/*

COPY app/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --prefix=/install -r /tmp/requirements.txt


# ── Stage 3: runtime ──────────────────────────────────────────────────────────
FROM base AS runtime

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Create non-root user
RUN groupadd --gid 1001 appuser \
    && useradd --uid 1001 --gid appuser --no-create-home appuser \
    && mkdir -p /var/lib/mqtt-ingestor/spool /var/lib/mqtt-ingestor/settings \
    && chown -R appuser:appuser /var/lib/mqtt-ingestor

WORKDIR /app

# Copy application source
COPY app/ingestor/ ./ingestor/
COPY app/migrations/ ./migrations/
COPY app/main.py .
COPY app/healthcheck.py .

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8080
EXPOSE 9108

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
    CMD ["python", "healthcheck.py"]

ENTRYPOINT ["python", "-u", "main.py"]
