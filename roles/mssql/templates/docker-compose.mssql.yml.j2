services:
  mssql:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: mssql
    restart: unless-stopped
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: "Developer"
      MSSQL_SA_PASSWORD: "{{ mssql_sa_password }}"
    ports:
      - "{{ mssql_port }}:1433"
    volumes:
      - mssql_data:/var/opt/mssql
    healthcheck:
      # $$ (not $) is required: docker compose interpolates $VAR from its own
      # invoking shell when parsing this file, before the container even
      # starts -- since MSSQL_SA_PASSWORD isn't set there, a single $ gets
      # silently substituted with an empty string and baked into the stored
      # healthcheck permanently. $$ passes a literal $ through so the
      # container's own shell expands it at runtime from `environment:` above.
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$$MSSQL_SA_PASSWORD\" -Q 'SELECT 1' -No -C 2>/dev/null | grep -q '1' || exit 1"]
      interval: 30s
      timeout: 15s
      retries: 5
      start_period: 60s
    networks:
      - {{ docker_shared_network | default('infra') }}

volumes:
  mssql_data:

networks:
  {{ docker_shared_network | default('infra') }}:
    external: true
